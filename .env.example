# =========================
# PostgreSQL
# =========================
POSTGRES_USER=thinktank
POSTGRES_PASSWORD=replace_with_strong_password
POSTGRES_DB=thinktank_monitor

DATABASE_URL=postgresql+asyncpg://thinktank:replace_with_strong_password@postgres:5432/thinktank_monitor

# =========================
# Redis / Celery
# =========================
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# =========================
# MinIO
# =========================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace_with_strong_password
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=replace_with_strong_password
MINIO_BUCKET=thinktank-documents
MINIO_SECURE=false

# =========================
# Security
# 使用命令生成：
# python -c "import secrets; print(secrets.token_urlsafe(64))"
# =========================
JWT_SECRET_KEY=replace_with_a_long_random_string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120

# =========================
# CORS
# 多个地址使用逗号分隔
# =========================
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# =========================
# LLM / Translation service
# =========================
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_CONNECT_TIMEOUT_SECONDS=20
LLM_READ_TIMEOUT_SECONDS=300
LLM_WRITE_TIMEOUT_SECONDS=30
LLM_POOL_TIMEOUT_SECONDS=20
AI_TRANSLATION_CHUNK_LENGTH=3000
AI_ANALYSIS_CHUNK_LENGTH=16000
AI_TRANSLATION_MAX_TOKENS=9000

# =========================
# Crawler
# =========================
CRAWLER_USER_AGENT=ThinkTankMonitor/0.1 (+contact@example.org)
CRAWLER_REQUEST_TIMEOUT=30
CRAWLER_MIN_REPORT_PAGE_COUNT=20
CRAWLER_MIN_WEB_ARTICLE_CONTENT_LENGTH=3000

# =========================
# Notifications
# 默认只生成站内通知。配置邮件或 webhook 后才会外发。
# 即时提醒建议初期保持关闭，避免试运行阶段打扰老师。
# =========================
NOTIFICATION_DAILY_SUMMARY_ENABLED=true
NOTIFICATION_SUMMARY_LOOKBACK_HOURS=24
NOTIFICATION_INSTANT_ALERTS_ENABLED=false

NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_EMAIL_TO=
NOTIFICATION_SMTP_HOST=
NOTIFICATION_SMTP_PORT=587
NOTIFICATION_SMTP_USERNAME=
NOTIFICATION_SMTP_PASSWORD=
NOTIFICATION_SMTP_FROM=
NOTIFICATION_SMTP_USE_TLS=true

NOTIFICATION_WECOM_WEBHOOK_URL=
NOTIFICATION_FEISHU_WEBHOOK_URL=
